/** Envía el token por Telegram */
async function enviarTokenTelegram(chatId, token, nombreUsuario) {
  const mensaje =
    `🔐 *Código de verificación*\n\n` +
    `Hola, *${nombreUsuario}*\\.\n\n` +
    `Tu código de acceso es:\n\n` +
    `\`\`\`\n${token}\n\`\`\`\n\n` +
    `⏱ Expira en *10 minutos*\\.\n` +
    `Si no solicitaste este acceso, ignora este mensaje\\.`;

  await telegramBot.sendMessage(chatId, mensaje, { parse_mode: "MarkdownV2" });
}

// ─── Endpoints ────────────────────────────────────────────────────────────────

/**
 * POST /usuarios/valida_login
 *
 * Paso 1 – Valida credenciales y crea la sesión interna.
 *
 * Body: { usuario: string, password: string }
 *
 * Respuesta exitosa:
 * {
 *   valido: 1,
 *   estado: 0,
 *   session_id: "uuid-generado",           ← usar en los siguientes pasos
 *   metodos_disponibles: ["email","telegram"] ← según lo que tenga en MongoDB
 * }
 *
 * El cliente guarda session_id y ya NO necesita reenviar el usuario.
 */
app.post("/usuarios/valida_login", async (req, res) => {
  try {
    const { usuario, password } = req.body;

    if (!usuario || !password) {
      return res.json({
        valido: 0, estado: 1,
        mensaje: "Faltan datos: se requieren 'usuario' y 'password'",
      });
    }

    // Buscar usuario en MongoDB
    const user = await collection.findOne({
      usuario:  usuario,
      password: hashPassword(password),
      deleted:  false,
    });

    if (!user) {
      return res.json({
        valido: 0, estado: 2,
        mensaje: "Usuario o contraseña incorrectos",
      });
    }

    // Determinar métodos 2FA disponibles según campos en MongoDB
    const metodos = [];
    if (user.correo)           metodos.push("email");
    if (user.telegram_chat_id) metodos.push("telegram");

    if (metodos.length === 0) {
      return res.json({
        valido: 0, estado: 4,
        mensaje: "El usuario no tiene ningún método 2FA registrado (correo o Telegram)",
      });
    }

    // Crear sesión temporal — el usuario ya NO necesita reenviar su nombre
    const session_id = generarSessionId();
    sesiones[session_id] = {
      usuario:          user.usuario,
      correo:           user.correo           || null,
      telegram_chat_id: user.telegram_chat_id || null,
      token:            null,
      token_expira:     null,
      metodos,
      sesion_expira:    new Date(Date.now() + SESSION_TTL),
      autenticado:      false,
    };

    console.log(`✅ Login OK: "${usuario}" | sesión: ${session_id} | métodos: ${metodos.join(", ")}`);

    return res.json({
      valido: 1,
      estado: 0,
      session_id,
      metodos_disponibles: metodos,
      mensaje: `Elige un método de verificación: ${metodos.join(" o ")}`,
    });

  } catch (error) {
    console.error("❌ /valida_login:", error.message);
    return res.json({ valido: 0, estado: 3, mensaje: "Error interno del servidor" });
  }
});

/**
 * POST /usuarios/solicita_token
 *
 * Paso 2 – El usuario elige el método y se envía el token.
 * NO requiere reenviar el nombre de usuario.
 *
 * Body: { session_id: string, metodo: "email" | "telegram" }
 *
 * Respuesta:
 *   estado 0 → Token enviado correctamente
 *   estado 1 → Faltan datos
 *   estado 2 → Sesión no encontrada o expirada
 *   estado 3 → Método no disponible para este usuario
 *   estado 4 → Error interno
 */
app.post("/usuarios/solicita_token", async (req, res) => {
  try {
    const { session_id, metodo } = req.body;

    if (!session_id || !metodo) {
      return res.json({
        valido: 0, estado: 1,
        mensaje: "Faltan datos: se requieren 'session_id' y 'metodo'",
      });
    }

    // Recuperar sesión (sin necesidad de que el usuario reenvíe su nombre)
    const sesion = sesiones[session_id];

    if (!sesion || new Date() > sesion.sesion_expira) {
      if (sesion) delete sesiones[session_id];
      return res.json({
        valido: 0, estado: 2,
        mensaje: "Sesión no encontrada o expirada. Vuelve a iniciar sesión.",
      });
    }

    // Verificar que el método elegido esté disponible para este usuario
    if (!sesion.metodos.includes(metodo)) {
      return res.json({
        valido: 0, estado: 3,
        mensaje: `El método "${metodo}" no está disponible para este usuario. Métodos disponibles: ${sesion.metodos.join(", ")}`,
      });
    }

    // Generar token y guardarlo en la sesión
    const token = generarToken4Digitos();
    sesion.token        = token;
    sesion.token_expira = new Date(Date.now() + TOKEN_TTL);

    let destino = "";

    if (metodo === "email") {
      await enviarTokenEmail(sesion.correo, token, sesion.usuario);
      destino = sesion.correo;
      console.log(`📧 Token "${token}" enviado por email a ${destino}`);

    } else if (metodo === "telegram") {
      await enviarTokenTelegram(sesion.telegram_chat_id, token, sesion.usuario);
      destino = `Telegram (chat_id: ${sesion.telegram_chat_id})`;
      console.log(`✈️  Token "${token}" enviado por Telegram a ${destino}`);
    }

    return res.json({
      valido: 1,
      estado: 0,
      mensaje: `Código enviado por ${metodo === "email" ? "correo electrónico" : "Telegram"}. Válido por 10 minutos.`,
    });

  } catch (error) {
    console.error("❌ /solicita_token:", error.message);
    return res.json({ valido: 0, estado: 4, mensaje: "Error interno del servidor" });
  }
});

/**
 * POST /usuarios/valida_token
 *
 * Paso 3 – Verifica el token. El usuario NO reenvía su nombre, solo el token.
 *
 * Body: { session_id: string, token: string }
 *
 * Respuesta:
 *   estado 0 → Autenticación 2FA completada
 *   estado 1 → Faltan datos
 *   estado 2 → Sesión no encontrada o expirada
 *   estado 3 → Token no solicitado aún (falta llamar a /solicita_token)
 *   estado 4 → Token expirado
 *   estado 5 → Token incorrecto
 *   estado 6 → Error interno
 */
app.post("/usuarios/valida_token", async (req, res) => {
  try {
    const { session_id, token } = req.body;

    if (!session_id || !token) {
      return res.json({
        valido: 0, estado: 1,
        mensaje: "Faltan datos: se requieren 'session_id' y 'token'",
      });
    }

    // Recuperar sesión — sin reenviar el usuario
    const sesion = sesiones[session_id];

    if (!sesion || new Date() > sesion.sesion_expira) {
      if (sesion) delete sesiones[session_id];
      return res.json({
        valido: 0, estado: 2,
        mensaje: "Sesión no encontrada o expirada. Vuelve a iniciar sesión.",
      });
    }

    if (!sesion.token) {
      return res.json({
        valido: 0, estado: 3,
        mensaje: "Primero solicita el token con /usuarios/solicita_token",
      });
    }

    if (new Date() > sesion.token_expira) {
      sesion.token = null;
      return res.json({
        valido: 0, estado: 4,
        mensaje: "El código ha expirado. Vuelve a solicitarlo.",
      });
    }

    if (token !== sesion.token) {
      return res.json({
        valido: 0, estado: 5,
        mensaje: "Código incorrecto.",
      });
    }

    // Autenticación completa — limpiar sesión
    const usuarioAutenticado = sesion.usuario;
    delete sesiones[session_id];

    console.log(`🎉 Autenticación 2FA completada para "${usuarioAutenticado}"`);

    return res.json({
      valido:   1,
      estado:   0,
      usuario:  usuarioAutenticado,
      mensaje:  "Autenticación de dos factores completada correctamente.",
    });

  } catch (error) {
    console.error("❌ /valida_token:", error.message);
    return res.json({ valido: 0, estado: 6, mensaje: "Error interno del servidor" });
  }
});

