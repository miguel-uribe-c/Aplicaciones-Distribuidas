// ─── Store de sesiones ────────────────────────────────────────────────────────
//
// Después de /valida_login se crea una sesión temporal con un session_id único.
// El usuario usa ese session_id en los siguientes pasos, sin reenviar su nombre.
//
// Formato:
// {
//   [session_id]: {
//     usuario:          string,
//     correo:           string | null,
//     telegram_chat_id: string | null,
//     token:            string | null,
//     metodos:          string[],        // ["email", "telegram"] disponibles
//     expira:           Date,
//     autenticado:      boolean
//   }
// }

const sesiones     = {};
const SESSION_TTL  = 15 * 60 * 1000; // 15 min para completar el flujo 2FA
const TOKEN_TTL    = 10 * 60 * 1000; // 10 min de vida del token

// ─── Utilidades ───────────────────────────────────────────────────────────────

function hashPassword(password) {
  return crypto.createHash("sha256").update(password).digest("hex");
}

function generarToken4Digitos() {
  return String(crypto.randomInt(0, 10000)).padStart(4, "0");
}

/** Genera un ID de sesión único (UUID v4 simplificado) */
function generarSessionId() {
  return crypto.randomUUID();
}

